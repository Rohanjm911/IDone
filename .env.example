# ==============================================================================
# IDone Environment Configuration
# ==============================================================================

# Backend Service
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=True

# Security & Secrets (generate a real 32+ byte string in production)
SECRET_KEY=idone-super-secure-production-secret-key-entropy-change-me-32b
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
VAULT_ENCRYPTION_MASTER_KEY=94a6e3557e23b2c14589d81d24c04294b05a76e1081b7e289bfad1694f29a008

# Database Settings
# Primary: PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/idone
# Fallback to local SQLite if PostgreSQL is unreachable during local development
DATABASE_FALLBACK_SQLITE=true

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Identity & Issuer Settings
ISSUER_DID=did:idone:issuer:foundation-core-alpha-01
ISSUER_NAME=IDone Foundation Authority

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_CREDENTIAL_STATUS_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# Blockchain Deployment (EVM)
RPC_URL=https://rpc.sepolia.org
DEPLOYER_PRIVATE_KEY=
